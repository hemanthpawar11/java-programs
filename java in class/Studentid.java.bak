	{ 
		this.sid = sid;
		
	}
	
	{
		this.sid = sid;
		this.sname = sname;
	}
	
	{
		this.sid = sid;
		this.sname = sname;
		this.sage = sage;
	}
	
	{
		this.sid = sid;
		this.sname = sname;
		this.sage = sage;
		this.sgf = sgf;
	}
	
	public static void main(String[] args) 
	{
		student2 s1= new student2(01);
