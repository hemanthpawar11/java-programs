class Starpattern 
{
	public static void main(String[] args) 
	{
		int n = 5;
		for (int i=n;i<=n;i++){
		 for (int j=n;j<=n;j++ ){ 
		 if (j==1 || i==1 || j==5 || i==5 || i==j || i+j==6)
			 {
	   System.out.print("* ");
		 }
			   else {
				 
				   System.out.print("  ");
			   }
			    
		}
		System.out.println();
		
	}
	}
}
 